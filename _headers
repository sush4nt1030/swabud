/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://formsubmit.co https://*.supabase.co wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formsubmit.co

/opportunities/*.ics
  Content-Type: text/calendar; charset=utf-8

/assets/*
  Cache-Control: public, max-age=604800

/_source/*
  X-Robots-Tag: noindex

/supabase/*
  X-Robots-Tag: noindex

/admin.html
  X-Robots-Tag: noindex
  Cache-Control: no-store

/listing.html
  X-Robots-Tag: noindex

